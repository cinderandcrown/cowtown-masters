{
  "name": "Generate Score Alerts on Golfer Update",
  "description": "Creates birdie/eagle/round-finish notifications when golfer scores are updated during the live tournament.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"score_to_par\") != null) or (.trigger.changed_fields | index(\"thru\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Golfer"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generate_score_alerts_on_golfer_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateScoreAlerts",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateScoreAlerts"
  }
}